server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Security headers ──────────────────────────────────────────────────────
    add_header X-Frame-Options          "DENY"                            always;
    add_header X-Content-Type-Options   "nosniff"                         always;
    add_header X-XSS-Protection         "1; mode=block"                   always;
    add_header Referrer-Policy          "strict-origin-when-cross-origin" always;

    # Content-Security-Policy — single line to avoid nginx multi-line header bugs.
    # style-src-elem is set explicitly because Vuetify injects <style> elements
    # at runtime; without it, modern browsers fall back to default-src.
    #
    # ${API_BASE_URL} / ${WS_URL} are substituted at container startup (see the
    # root Dockerfile's nginx stage + docker-compose.yml's frontend
    # environment:) from the SAME values baked into the frontend bundle at
    # build time, plus their ws(s):// equivalents for the Socket.IO
    # connection continuous_monitoring.vue opens against API_BASE_URL. This
    # file is a *template* (nginx's official image envsubst's any
    # /etc/nginx/templates/*.template into conf.d/ on startup) — edit
    # nginx.conf.template, not a generated nginx.conf, and never hardcode a
    # deployment-specific IP here again.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob:; worker-src blob:; connect-src 'self' https://cdn.jsdelivr.net ${API_BASE_URL} ${API_BASE_URL_WS} ${WS_URL};" always;

    # Uncomment when TLS is configured:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # ─────────────────────────────────────────────────────────────────────────

    # SPA fallback — all routes served by index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Block access to hidden files (.git, .env, etc.)
    location ~ /\. {
        deny all;
    }

    # Cache static assets aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
