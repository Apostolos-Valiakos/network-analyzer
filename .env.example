# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Frontend ---
# URL of the Flask backend (REST API)
API_BASE_URL=http://127.0.0.1:5555

# WebSocket URL for real-time events (must be named WS_URL — this is the
# only websocket variable nuxt.config.js actually exposes to the frontend)
WS_URL=ws://127.0.0.1:5002

# --- Backend (server/) ---
# Strong random JWT secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<REPLACE_WITH_RANDOM_64_CHAR_HEX>

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@localhost:5432/network_analyzer

# Internal communication token shared between the sensor agent and the backend.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_TOKEN=<REPLACE_WITH_RANDOM_64_CHAR_HEX>

# Address of the sensor's pcap_server.py (pcap slices, nmap scans).
# Default http://172.18.0.1:5005 only works when the sensor runs on the Docker host.
# SENSOR_URL=http://<sensor-ip>:5005

# Optional: full path to tshark when it is not on PATH. If unset, the backend
# looks on PATH, then (Windows) where Wireshark is registered as installed.
# TSHARK_PATH=E:\Wireshark\tshark.exe

# Comma-separated list of allowed CORS origins (frontend URL)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000

# --- First admin account (created automatically on first boot if no admin exists) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
